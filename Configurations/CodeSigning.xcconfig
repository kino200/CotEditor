// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// Use default code signing for application release.
CODE_SIGN_IDENTITY = Developer ID Application: MarkAny Inc. (9N6VX5RKP7)
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = 9N6VX5RKP7

// Uncomment the following line to override these settings for ad-hoc local development.
//#include "CodeSigning-AdHoc.xcconfig"

CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
